# --- Meta / WhatsApp Cloud API ---
# Meta for Developers > seu App > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890
GRAPH_API_VERSION=v20.0

# Token que você inventa e cadastra no painel do Webhook da Meta (Verify Token)
WEBHOOK_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

# --- Banco de dados ---
# Se usar Vercel Postgres (Storage > Postgres no dashboard da Vercel),
# essas variáveis são geradas automaticamente ao conectar o banco ao projeto.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Segurança do painel ---
# Senha simples pra proteger o dashboard (login básico), troque isso
DASHBOARD_PASSWORD=troque-esta-senha
